{
  "uid": "sdi-stream-ingestion",
  "title": "SDI \u00b7 2 \u00b7 Streaming Ingestion",
  "description": "IoT telemetry micro-batches via POST /ingest/stream/iot",
  "tags": [
    "sdi",
    "data-engineering"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Stream throughput (events/s)",
      "description": "Total records ingested / total stream processing seconds.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(sum(events_committed)/nullif(sum(duration_s),0)) AS \"Events/s\" FROM ops.stream_batch_log WHERE $__timeFilter(committed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "End-to-end latency p95 (s)",
      "description": "Timestamp_db_insert - Timestamp_source_row_creation (_emitted_at).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_p95_s)::numeric,3) AS \"p95 s\" FROM ops.stream_batch_log WHERE $__timeFilter(committed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Malformed / dropped",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(events_malformed) AS \"Dropped\" FROM ops.stream_batch_log WHERE $__timeFilter(committed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#e34948"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events committed",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(events_committed) AS \"Committed\" FROM ops.stream_batch_log WHERE $__timeFilter(committed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Stream throughput per micro-batch (events/s)",
      "description": "Recommended chart: pipeline stability over the simulation run.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT committed_at AS time, throughput_eps AS \"Throughput (eps)\" FROM ops.stream_batch_log WHERE $__timeFilter(committed_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "drawStyle": "line",
            "pointSize": 6,
            "showPoints": "auto",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "End-to-end latency (s)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT committed_at AS time, latency_avg_s AS \"avg\", latency_p95_s AS \"p95\" FROM ops.stream_batch_log WHERE $__timeFilter(committed_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "drawStyle": "line",
            "pointSize": 6,
            "showPoints": "auto",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Dropped records by reason",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN reason LIKE 'duplicate%' THEN 'Duplicate key' WHEN reason LIKE '%SensorReadingID%' THEN 'Null key' WHEN reason LIKE 'ValueError: could not convert%' THEN 'Schema mismatch (type)' ELSE 'Invalid timestamp / other' END AS \"Reason\", count(*) AS \"Events\" FROM ops.stream_rejects WHERE $__timeFilter(rejected_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e34948"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": null,
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "barRadius": 0.1
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Stream runs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT stream_run_id AS \"Run\", batch_label AS \"Batch\", count(*) AS \"Micro-batches\", sum(events_received) AS \"Received\", sum(events_committed) AS \"Committed\", sum(events_malformed) AS \"Dropped\", round((sum(events_committed)/nullif(extract(epoch FROM max(committed_at)-min(received_at)),0))::numeric) AS \"Events/s (wall)\", round(avg(latency_avg_s)::numeric,3) AS \"Avg latency s\" FROM ops.stream_batch_log GROUP BY 1,2 ORDER BY min(received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "batch",
        "label": "Batch / refresh",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "sdi-postgres"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "query": "SELECT DISTINCT batch_label FROM ops.batch_load_log ORDER BY 1"
      }
    ]
  }
}