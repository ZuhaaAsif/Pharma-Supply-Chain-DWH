{
  "uid": "sdi-batch-ingestion",
  "title": "SDI \u00b7 1 \u00b7 Batch Ingestion",
  "description": "File-watcher -> ingestion API -> ODS -> staging validation",
  "tags": [
    "sdi",
    "data-engineering"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Batch success rate",
      "description": "Successful runs / attempted runs x 100 (ODS load + staging validation).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0*count(*) FILTER (WHERE status='SUCCESS')/nullif(count(*),0),2) AS \"Success %\" FROM ops.batch_load_log WHERE batch_label IN (${batch:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 95
              },
              {
                "color": "#0ca30c",
                "value": 99.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rows processed (ODS)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(rows_loaded) AS \"Rows\" FROM ops.batch_load_log WHERE stage='ODS_LOAD' AND batch_label IN (${batch:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rows rejected by validation",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(rows_rejected) AS \"Rejected\" FROM ops.batch_load_log WHERE stage='STAGING_VALIDATE' AND batch_label IN (${batch:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#e34948"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Files ingested",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Files\" FROM ops.batch_load_log WHERE stage='ODS_LOAD' AND status='SUCCESS' AND batch_label IN (${batch:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Batch load duration (s) per source file",
      "description": "Recommended chart: which large file takes the longest. Timestamp_end - Timestamp_start per file.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT file_name AS \"Source file\", round(avg(duration_s)::numeric,3) AS \"ODS load (s)\", round((SELECT avg(v.duration_s) FROM ops.batch_load_log v WHERE v.stage='STAGING_VALIDATE' AND v.source_key=l.source_key AND v.batch_label IN (${batch:sqlstring}))::numeric,3) AS \"Validation (s)\" FROM ops.batch_load_log l WHERE stage='ODS_LOAD' AND batch_label IN (${batch:sqlstring}) GROUP BY file_name, source_key ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": null,
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "barRadius": 0.1,
        "stacking": "normal"
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Rows processed per batch (by source)",
      "description": "len(df) after pandas load, per file per refresh (log scale: files differ by 4 orders of magnitude).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source_key AS \"Source\", sum(rows_loaded) FILTER (WHERE batch_label='base') AS \"base\", sum(rows_loaded) FILTER (WHERE batch_label LIKE 'refresh_01%') AS \"refresh 1\", sum(rows_loaded) FILTER (WHERE batch_label LIKE 'refresh_02%') AS \"refresh 2\" FROM ops.batch_load_log WHERE stage='ODS_LOAD' GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": null,
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "barRadius": 0.1,
        "xTickLabelRotation": -30,
        "yAxis": {
          "scale": "log"
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Validation rejects by rule",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT split_part(reason,' ',1)||' '||split_part(reason,' ',2)||' '||split_part(reason,' ',3) AS \"Rule\", count(*) AS \"Rows\" FROM staging.rejects WHERE batch_label IN (${batch:sqlstring}) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e34948"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": null,
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "barRadius": 0.1
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Load audit (latest 50)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Started\", batch_label AS \"Batch\", stage AS \"Stage\", file_name AS \"File\", rows_read AS \"Read\", rows_loaded AS \"Loaded\", rows_rejected AS \"Rejected\", round(duration_s::numeric,2) AS \"Seconds\", status AS \"Status\" FROM ops.batch_load_log WHERE batch_label IN (${batch:sqlstring}) ORDER BY load_id DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "batch",
        "label": "Batch / refresh",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "sdi-postgres"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "query": "SELECT DISTINCT batch_label FROM ops.batch_load_log ORDER BY 1"
      }
    ]
  }
}