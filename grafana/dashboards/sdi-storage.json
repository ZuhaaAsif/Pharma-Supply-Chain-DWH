{
  "uid": "sdi-storage",
  "title": "SDI \u00b7 3 \u00b7 Storage & Staging",
  "description": "Postgres ODS/staging + DuckDB mart footprint and coverage",
  "tags": [
    "sdi",
    "data-engineering"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Postgres database (MB)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(size_mb::numeric,1) AS \"MB\" FROM ops.storage_snapshot WHERE layer='database' AND store='postgres' AND captured_at = (SELECT max(captured_at) FROM ops.storage_snapshot)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "unit": "decmbytes",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
