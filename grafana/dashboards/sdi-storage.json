    {
      "id": 5,
      "type": "piechart",
      "title": "Storage breakdown - % of staging rows by source domain",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT domain AS \"Domain\", row_count AS \"Rows\" FROM ops.storage_snapshot WHERE layer='staging' AND captured_at = (SELECT max(captured_at) FROM ops.storage_snapshot) ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "percent"
          ]
        },
        "displayLabels": []
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Storage footprint (MB) by domain and layer",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT domain AS \"Domain\", round(sum(size_mb) FILTER (WHERE layer='ods')::numeric,1) AS \"ODS (bronze)\", round(sum(size_mb) FILTER (WHERE layer='staging')::numeric,1) AS \"Staging (silver)\" FROM ops.storage_snapshot WHERE layer IN ('ods','staging') AND captured_at = (SELECT max(captured_at) FROM ops.storage_snapshot) GROUP BY 1 ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": null,
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "barRadius": 0.1,
        "stacking": "normal"
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Fact-table growth per refresh (history is appended, never truncated)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT batch_label AS \"Batch\", max(row_count) FILTER (WHERE table_name='mart.fact_sales') AS \"fact_sales\", max(row_count) FILTER (WHERE table_name='staging.stg_iot') AS \"stg_iot\", max(row_count) FILTER (WHERE table_name='staging.stg_warehouse') AS \"stg_warehouse\" FROM ops.storage_snapshot GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": null,
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "barRadius": 0.1,
        "xTickLabelRotation": -30
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Date coverage span (validation of 2023 -> 2026 range)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT layer AS \"Layer\", table_name AS \"Table\", row_count AS \"Rows\", min_date AS \"Min date\", max_date AS \"Max date\", (max_date-min_date) AS \"Span (days)\", distinct_months AS \"Months\" FROM ops.storage_snapshot WHERE min_date IS NOT NULL AND layer IN ('staging','mart') AND captured_at = (SELECT max(captured_at) FROM ops.storage_snapshot) ORDER BY 1,2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "batch",
        "label": "Batch / refresh",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "sdi-postgres"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "query": "SELECT DISTINCT batch_label FROM ops.batch_load_log ORDER BY 1"
      }
